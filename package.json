{
  "name": "tail-quant-platform",
  "version": "1.0.0",
  "private": true,
  "description": "TAIL Quant & Paper Trading Simulation Platform",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue.bold,green.bold\" \"python nse-dashboard/app.py\" \"npm run dev --prefix frontend\"",
    "start": "python run_sim.py",
    "backend": "python nse-dashboard/app.py",
    "frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
